<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bulkup.raptor.order.infrastructure.mybatis.OrderHistoryMapper">
    <resultMap id="orderRow" type="com.bulkup.raptor.order.infrastructure.mybatis.OrderHistoryMapper$OrderRow">
        <constructor>
            <idArg column="id" javaType="java.lang.Long" />
            <arg column="status" javaType="java.lang.String" />
            <arg column="total_amount" javaType="_long" />
            <arg column="created_at" javaType="java.time.Instant" />
            <arg column="cancellation_pending" javaType="_boolean" />
        </constructor>
    </resultMap>
    <resultMap id="itemRow" type="com.bulkup.raptor.order.infrastructure.mybatis.OrderHistoryMapper$ItemRow">
        <constructor>
            <idArg column="order_id" javaType="java.lang.Long" />
            <arg column="product_name" javaType="java.lang.String" />
            <arg column="quantity" javaType="_int" />
        </constructor>
    </resultMap>
    <sql id="memberStatusFilter">
        WHERE o.member_id = #{memberId}
        <if test="status != null">AND o.status = #{status}</if>
    </sql>
    <select id="count" resultType="long">
        SELECT COUNT(*) FROM orders o
        <include refid="memberStatusFilter" />
    </select>
    <select id="findOrders" resultMap="orderRow">
        SELECT o.id, o.status, o.total_amount, o.created_at,
            (o.paid_cancellation_pending OR (o.status = 'CREATED' AND EXISTS (
                SELECT 1 FROM stock_reservations r
                WHERE r.order_id = o.id AND r.status IN ('RELEASE_PENDING', 'REVIEW_REQUIRED')
                  AND EXISTS (SELECT 1 FROM payments p WHERE p.order_id = o.id
                      AND p.status &lt;&gt; 'RETIRED' AND NOT p.keep_order_on_release)
            ))) AS cancellation_pending
        FROM orders o
        <include refid="memberStatusFilter" />
        ORDER BY o.created_at DESC, o.id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>
    <select id="findItems" resultMap="itemRow">
        SELECT i.order_id, i.product_name, i.quantity
        FROM order_items i JOIN orders o ON o.id = i.order_id
        WHERE o.member_id = #{memberId} AND i.order_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
        ORDER BY i.order_id, i.id
    </select>
</mapper>
